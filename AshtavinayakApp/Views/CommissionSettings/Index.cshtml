@model AshtavinayakAPP.Models.CommissionSetting

@{
    ViewData["Title"] = "Commission Settings";
}

<link href="~/CSS/Category/edit.css" rel="stylesheet" />

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<div class="d-flex justify-content-center align-items-center">
    <div class="shadow-lg p-4 bg-white rounded" style="width: 50%;">

        <div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
            <h4>Commission Settings</h4>
        </div>
        <hr />

        <p class="text-muted">
            This is the default commission percentage applied to agents who don't have a
            per-agent override set (see the Agents section to set one). Changes apply to
            future bookings only — already-placed bookings keep the commission figures
            recorded at the time they were made.
        </p>

        <form asp-action="Index" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Default Commission Percentage</label>
                <input type="number" step="0.01" min="0" max="100" name="defaultCommissionPercentage"
                       class="form-control" value="@(Model?.DefaultCommissionPercentage ?? 10)" required />
            </div>

            <div class="form-group text-center mt-3">
                <button type="submit" class="btn btn-secondaryN" style="background-color:dodgerblue">Save</button>
            </div>
        </form>

        @if (Model != null)
        {
            <p class="text-muted text-center mt-2">Last updated: @Model.UpdatedAt.ToString("dd-MM-yyyy HH:mm")</p>
        }

    </div>
</div>
