@model AshtavinayakAPP.Models.Vehicle

@{
    ViewData["Title"] = "Create Vehicle";
}

<link href="~/css/category/create.css" rel="stylesheet" />
<!-- Include SweetAlert CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="d-flex justify-content-center align-items-center">
    <div class="shadow-lg p-4 bg-white rounded" style="width: 50%;">
        <div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
            <h4>Create Vehicle</h4>
            <a asp-action="Index" class="close-btn" title="Back to List">❌</a>
        </div>
        <hr />
        <form id="vehicleForm" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Vehicle Type Input -->
            <div class="form-group mb-2">
                <label asp-for="VehicleType" class="control-label"></label><span style="color: red;">*</span>
                <input asp-for="VehicleType" class="form-control" required placeholder="Enter Vehicle Type" />
                <span asp-validation-for="VehicleType" class="text-danger"></span>
            </div>

            <!-- Vehicle Name Input -->
            <div class="form-group mb-2">
                <label asp-for="VehicleName" class="control-label"></label><span style="color: red;">*</span>
                <input asp-for="VehicleName" class="form-control" required placeholder="Enter Vehicle Name" />
                <span asp-validation-for="VehicleName" class="text-danger"></span>
            </div>

            <!-- Vehicle Number Input -->
            @*  <div class="form-group mb-2">
            <label asp-for="VehicleNumber" class="control-label"></label><span style="color: red;">*</span>
            <input asp-for="VehicleNumber" class="form-control" required placeholder="Enter Vehicle Number" />
            <span asp-validation-for="VehicleNumber" class="text-danger"></span>
            </div> *@
            <div class="form-group mb-2">
                <label asp-for="VehicleNumber" class="control-label"></label><span style="color: red;">*</span>
                <input asp-for="VehicleNumber" class="form-control" required placeholder="Enter Vehicle Number" />
                <span asp-validation-for="VehicleNumber" class="text-danger"></span>
            </div>

            <!-- Total Seats Input -->
            <div class="form-group mb-2">
                <label asp-for="TotalSeats" class="control-label"></label><span style="color: red;">*</span>
                <input asp-for="TotalSeats" class="form-control" required placeholder="Enter Total Seats" />
                <span asp-validation-for="TotalSeats" class="text-danger"></span>
            </div>

            <!-- Driver Name Input -->
            <div class="form-group mb-2">
                <label asp-for="DriverName" class="control-label"></label><span style="color: red;">*</span>
                <input asp-for="DriverName" class="form-control" required placeholder="Enter Driver Name" />
                <span asp-validation-for="DriverName" class="text-danger"></span>
            </div>

            <!-- Driver Contact Input -->
            @*   <div class="form-group mb-2">
            <label asp-for="DriverContact" class="control-label"></label><span style="color: red;">*</span>
            <input asp-for="DriverContact" class="form-control" required placeholder="Enter Driver Contact" />
            <span asp-validation-for="DriverContact" class="text-danger"></span>
            </div> *@
            <!-- Driver Contact Input -->
            <div class="form-group mb-2">
                <label asp-for="DriverContact" class="control-label"></label><span style="color: red;">*</span>
                <input asp-for="DriverContact" class="form-control" required placeholder="Enter Driver Contact"
                       pattern="^\d{10}$" title="Please enter a valid 10-digit contact number." />
                <span asp-validation-for="DriverContact" class="text-danger"></span>
            </div>

            <!-- Trip Dropdown -->
            <div class="form-group mb-2">
                <label asp-for="TripId" class="control-label">Trip Name</label>
                <select asp-for="TripId" class="form-control" asp-items="ViewBag.TripId" required>
                    <option value="">Select Trip Name</option>
                </select>
                <span asp-validation-for="TripId" class="text-danger"></span>
            </div>

            

            <!-- Submit and Cancel Buttons -->
            <div class="form-group text-center">
                <button type="button" id="submitButton" class="btn btn-secondaryN" style="background-color:dodgerblue">Create</button>
                <button type="button" id="cancelButton" class="btn btn-secondaryN" style="background-color:red;">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
    // SweetAlert for Submit Button
    document.getElementById('submitButton').addEventListener('click', function (e) {
        e.preventDefault(); // Prevent the default button behavior

        // Check if form is valid before submitting
        var form = document.getElementById('vehicleForm');
        if (form.checkValidity()) {
            Swal.fire({
                title: "Are you sure?",
                text: "Do you want to add this vehicle?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, Add it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit(); // Submit the form if confirmed
                }
            });
        } else {
            // If form is not valid, trigger HTML5 validation
            form.reportValidity(); // This will display the default validation messages
        }
    });

    // SweetAlert for Cancel Button
    document.getElementById('cancelButton').addEventListener('click', function (e) {
        Swal.fire({
            title: "Are you sure?",
            text: "Your changes will be lost!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, Cancel!"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '@Url.Action("Index", "Vehicles")'; // Redirect if confirmed
            }
        });
    });


</script>
