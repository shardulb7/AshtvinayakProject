@model AshtavinayakAPP.Models.Vehicle

@{
    ViewData["Title"] = "Delete";
}

<link href="~/CSS/Category/delete.css" rel="stylesheet" />

<div class="d-flex justify-content-center align-items-center">
    <div class="shadow-lg p-4 bg-white rounded" style="width: 50%;">

        <div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
            <h4>Delete Vehicle</h4>
            <a asp-action="Index" class="close-btn" title="Back to List">❌</a>
        </div>

        <hr />

        <div class="card mt-3">
            <div class="card-body">
                <h3 class="card-title">Are you sure you want to delete this?</h3>
                <h4>Vehicle Details</h4>
                <hr />

                <dl class="row">
                    <div class="col-md-4">
                        <dt>@Html.DisplayNameFor(model => model.VehicleType)</dt>
                    </div>
                    <div class="col-md-8">
                        <dd>@Html.DisplayFor(model => model.VehicleType)</dd>
                    </div>
                    <div class="col-md-4">
                        <dt>@Html.DisplayNameFor(model => model.VehicleName)</dt>
                    </div>
                    <div class="col-md-8">
                        <dd>@Html.DisplayFor(model => model.VehicleName)</dd>
                    </div>
                    <div class="col-md-4">
                        <dt>@Html.DisplayNameFor(model => model.VehicleNumber)</dt>
                    </div>
                    <div class="col-md-8">
                        <dd>@Html.DisplayFor(model => model.VehicleNumber)</dd>
                    </div>
                    <div class="col-md-4">
                        <dt>@Html.DisplayNameFor(model => model.TotalSeats)</dt>
                    </div>
                    <div class="col-md-8">
                        <dd>@Html.DisplayFor(model => model.TotalSeats)</dd>
                    </div>
                    <div class="col-md-4">
                        <dt>@Html.DisplayNameFor(model => model.DriverName)</dt>
                    </div>
                    <div class="col-md-8">
                        <dd>@Html.DisplayFor(model => model.DriverName)</dd>
                    </div>
                    <div class="col-md-4">
                        <dt>@Html.DisplayNameFor(model => model.DriverContact)</dt>
                    </div>
                    <div class="col-md-8">
                        <dd>@Html.DisplayFor(model => model.DriverContact)</dd>
                    </div>
                    <div class="col-md-4">
                        <dt>@Html.DisplayNameFor(model => model.Trip)</dt>
                    </div>
                    <div class="col-md-8">
                        <dd>@Html.DisplayFor(model => model.Trip.TourName)</dd>
                    </div>
                </dl>

                <form id="deleteForm" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="VehicleId" />
                    <div class="form-actions text-center">
                        <input type="submit" value="Delete" class="btn-secondaryN" style="background-color:dodgerblue;" id="deleteButton" />
                        <button type="button" id="cancelButton" class="btn-secondaryN" style="background-color:red;">Cancel</button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

<a href="@Url.Action("Index", "Vehicle")" class="close-btn" title="Back to List" style="position: absolute; top: 10px; right: 10px; font-size: 20px; background: none; border: none; color: black;">❌</a>

@section Scripts {
    <script>
        // Event listener for Delete button
        document.getElementById('deleteButton').addEventListener('click', function (e) {
            e.preventDefault(); // Prevent the form from being submitted immediately

            // Show confirmation dialog
            var userConfirmed = confirm("Are you sure you want to delete this vehicle?");

            // If the user confirms, submit the form
            if (userConfirmed) {
                document.getElementById('deleteForm').submit();
            } else {
                window.location.href = '@Url.Action("Index", "Vehicles")';
            }
        });

        // Event listener for Cancel button
        document.getElementById('cancelButton').addEventListener('click', function (e) {
            e.preventDefault(); // Prevent the default action

            // Redirect to index page or wherever necessary
            window.location.href = '@Url.Action("Index", "Vehicles")';
        });
    </script>
}
