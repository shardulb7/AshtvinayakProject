@model AshtavinayakAPP.Models.Trip

@{
    ViewData["Title"] = "Edit";
}

<link href="~/CSS/Category/edit.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="d-flex justify-content-center align-items-center">
    <div class="shadow-lg p-4 bg-white rounded" style="width: 50%;">


        <div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
            <h4>Edit Trip</h4>
            <a asp-action="Index" class="close-btn" title="Back to List">❌</a>
        </div>
        <hr />

        <form id="tripForm" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="TripId" />

            <div class="form-group">
                <label asp-for="PackageId" class="control-label">Package</label><span style="color: red;">*</span>
                <select asp-for="PackageId" class="form-control" asp-items="ViewBag.PackageId"></select>
                <span asp-validation-for="PackageId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CategoryId" class="control-label">Category</label><span style="color: red;">*</span>
                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TripDate" class="control-label">Trip Date</label><span style="color: red;">*</span>
                <input asp-for="TripDate" class="form-control" type="date" />
                <span asp-validation-for="TripDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TourName" class="control-label">Tour Name</label>
                <input asp-for="TourName" class="form-control" />
                <span asp-validation-for="TourName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TotalSeats" class="control-label">Total Seats</label><span style="color: red;">*</span>
                <input asp-for="TotalSeats" class="form-control" />
                <span asp-validation-for="TotalSeats" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="AvailableSeats" class="control-label">Available Seats</label><span style="color: red;">*</span>
                <input asp-for="AvailableSeats" class="form-control" />
                <span asp-validation-for="AvailableSeats" class="text-danger"></span>
            </div>

            <div class="form-group text-center">
                <button type="button" id="submitButton" class="btn btn-secondaryN" style="background-color:dodgerblue">Update</button>
                <button type="button" id="cancelButton" class="btn btn-secondaryN">Cancel</button>
            </div>
        </form>

    </div>
</div>

<script>
    // SweetAlert for Submit Button
    document.getElementById('submitButton').addEventListener('click', function (e) {
        Swal.fire({
            title: "Are you sure?",
            text: "Do you want to update the changes?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, Save it!"
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('tripForm').submit(); // Submit the form if confirmed
            }
        });
    });

    // SweetAlert for Cancel Button
    document.getElementById('cancelButton').addEventListener('click', function (e) {
        Swal.fire({
            title: "Are you sure?",
            text: "Your changes will be lost!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, Cancel!"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '@Url.Action("Index", "Trips")'; // Redirect if confirmed
            }
        });
    });
</script>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
