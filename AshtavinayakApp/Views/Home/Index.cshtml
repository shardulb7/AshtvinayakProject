<script>
    let currentIndex = 0;
    const cards = document.querySelectorAll('.cardmarquee');
    const totalCards = cards.length;
    const cardSlider = document.querySelector('.card-slider');
    const cardWidth = 200; // Width of the card (no margin, cards touch each other)
    const visibleCards = 1; // Number of cards visible at a time

    // Update container width to accommodate all cards
    cardSlider.style.width = `${cardWidth * totalCards}px`;

    // Function to move the slider
    function moveSlider(direction) {
        currentIndex += direction * visibleCards;

        // Adjust currentIndex for looping (infinite loop)
        if (currentIndex < 0) {
            currentIndex = totalCards - visibleCards; // Loop back to the last cards
        } else if (currentIndex >= totalCards) {
            currentIndex = 0; // Loop back to the first cards
        }

        // Move the slider by adjusting the transform property
        cardSlider.style.transition = 'transform 0.5s ease-in-out'; // Ensure smooth transition
        cardSlider.style.transform = `translateX(-${currentIndex * cardWidth}px)`;
    }

    // Automatically slide every 3 seconds
    setInterval(() => {
        moveSlider(1); // Automatically move to the next set of cards
    }, 3000); // 3000ms = 3 seconds

    // Reset the slider position for infinite loop effect
    cardSlider.addEventListener('transitionend', () => {
        if (currentIndex >= totalCards) {
            currentIndex = 0; // Reset index after moving past the last card
            cardSlider.style.transition = 'none'; // Disable transition for instant reset
            cardSlider.style.transform = `translateX(0)`; // Reset the slider to the start
            setTimeout(() => {
                cardSlider.style.transition = 'transform 0.5s ease-in-out'; // Re-enable transition after reset
            }, 50); // Delay for smooth transition reset
        }
    });
</script>

