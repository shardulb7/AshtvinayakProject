            </div>

            <div class="table-responsive rounded">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>User</th>
                            <th>Trip</th>
                            <th>Booking Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in recentBookings)
                        {
                            <tr>
                                <td>@booking.BookingId</td>
                                <td>@(booking.User?.UserName ?? "Not Available")</td>
                                <td>@(booking.Trip?.TripDate.ToString("yyyy-MM-dd") ?? "Not Available")</td>
                                <td>@(booking.BookingDate?.ToString("yyyy-MM-dd") ?? "Not Available")</td>
                                <td>@(booking.Status ?? "Not Available")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-lg-6 col-md-12 col-sm-12 p-3 mb-3 rounded">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Upcoming Trips</h3>
                <a href="@Url.Action("Index", "Trips")" class="btn" style="background-color: #D44206; color: white;">View Details</a>
            </div>

            <div class="table-responsive rounded">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Package ID</th>
                            <th>Date</th>
                            <th>Total Seats</th>
                            <th>Available Seats</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trip in ViewBag.RecentTrips)
                        {
                            <tr>
                                <td>@trip.PackageId</td>
                                <td>@trip.TripDate.ToString("yyyy-MM-dd")</td>
                                <td>@trip.TotalSeats</td>
                                <td>@trip.AvailableSeats</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>














