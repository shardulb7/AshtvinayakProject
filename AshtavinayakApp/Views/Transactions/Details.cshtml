@model AshtavinayakAPP.Models.Transaction

@{
    ViewData["Title"] = "Details";
}

<link href="~/CSS/category/details.css" rel="stylesheet" />

<div class="d-flex justify-content-center align-items-center">
    <div class="shadow-lg p-4 bg-white rounded" style="width: 50%;">

        <div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
            <h4>Details Transaction</h4>
            <a asp-action="Index" class="close-btn" title="Back to List">?</a>
        </div>

        <hr />

        <div class="card mt-3">
            <div class="card-body">
                <h4 class="card-title">Transaction Details</h4>

                <dl class="row">
                    <div class="col-md-12">
                        <!-- Payment Method -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-2 col-md-4">
                                        <dt>@Html.DisplayNameFor(model => model.PaymentMethod)</dt>
                                    </div>
                                    <div class="col-sm-10 col-md-8">
                                        <dd>@Html.DisplayFor(model => model.PaymentMethod)</dd>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Transaction Date -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-2 col-md-4">
                                        <dt>@Html.DisplayNameFor(model => model.TransactionDate)</dt>
                                    </div>
                                    <div class="col-sm-10 col-md-8">
                                        <dd>@Html.DisplayFor(model => model.TransactionDate)</dd>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Amount -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-2 col-md-4">
                                        <dt>@Html.DisplayNameFor(model => model.Amount)</dt>
                                    </div>
                                    <div class="col-sm-10 col-md-8">
                                        <dd>@Html.DisplayFor(model => model.Amount)</dd>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Payment Status -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-2 col-md-4">
                                        <dt>@Html.DisplayNameFor(model => model.PaymentStatus)</dt>
                                    </div>
                                    <div class="col-sm-10 col-md-8">
                                        <dd>@Html.DisplayFor(model => model.PaymentStatus)</dd>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Booking ID -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-2 col-md-4">
                                        <dt>@Html.DisplayNameFor(model => model.Booking.BookingId)</dt>
                                    </div>
                                    <div class="col-sm-10 col-md-8">
                                        <dd>@(Model?.Booking?.BookingId.ToString() ?? "-")</dd>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </dl>

                <p class="mt-3 text-center">
                    <a asp-action="Edit" asp-route-id="@Model?.TransactionId" class="btn btn-primary">Edit</a>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </p>
            </div>
        </div>

    </div>
</div>

