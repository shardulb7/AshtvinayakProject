@model AshtavinayakAPP.Models.TripRoute

@{
    ViewData["Title"] = "Create";
}

<link href="~/css/category/create.css" rel="stylesheet" />
<!-- Include SweetAlert CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="d-flex justify-content-center align-items-center">
    <div class="shadow-lg p-4 bg-white rounded" style="width: 50%;">

        <div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
            <h4>Add Trip Route</h4>
            <a asp-action="Index" class="close-btn" title="Back to List">❌</a>
        </div>
        <hr />

        <form id="tripRouteForm" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-2">
                <label asp-for="CityId" class="control-label"></label><span style="color: red;">*</span>
                <select asp-for="CityId" class="form-control" asp-items="ViewBag.CityId" required>
                    <option value="" disabled selected>Select City</option>
                </select>
                <span asp-validation-for="CityId" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="PackageId" class="control-label"></label><span style="color: red;">*</span>
                <select asp-for="PackageId" class="form-control" asp-items="ViewBag.PackageId" required>
                    <option value="" disabled selected>Select Package</option>
                </select>
                <span asp-validation-for="PackageId" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Day" class="control-label"></label><span style="color: red;">*</span>
                <input asp-for="Day" class="form-control" required placeholder="Enter Day" />
                <span asp-validation-for="Day" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label>Pickup Points</label><span style="color: red;">*</span>
                <div id="pickupPointsContainer">
                    <input type="text" class="form-control pickup-point" placeholder="Enter Pickup Point" required />
                </div>
                <button type="button" id="addPickupPoint" class="btn btn-sm btn-success mt-2">Add More</button>
                <span id="pickupError" class="text-danger"></span>
            </div>

            <input type="hidden" name="PointNames" id="PointNames" />

            <div class="form-group text-center">
                <button type="button" id="submitButton" class="btn btn-secondaryN" style="background-color:dodgerblue">Create</button>
                <button type="button" id="cancelButton" class="btn btn-secondaryN">Cancel</button>
            </div>
        </form>

    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        $('#CityId').change(function () {
            var cityId = $(this).val();
            if (cityId) {
                $.ajax({
                    url: '@Url.Action("GetPackagesByCity", "TripRoutes")',
                    type: 'GET',
                    data: { cityId: cityId },
                    success: function (data) {
                        var packageDropdown = $('#PackageId');
                        packageDropdown.empty();
                        packageDropdown.append('<option value="" disabled selected>Select Package</option>');
                        $.each(data, function (index, package) {
                            packageDropdown.append($('<option></option>').val(package.packageId).text(package.packageName));
                        });
                    },
                    error: function () {
                        alert('Failed to load packages. Please try again.');
                    }
                });
            }
        });

        $("#addPickupPoint").click(function () {
            let newRow = `
                    <div class="input-group mb-2">
                        <input type="text" class="form-control pickup-point" placeholder="Enter Pickup Point" required />
                        <button type="button" class="btn btn-danger removePickupPoint">Remove</button>
                    </div>`;
            $("#pickupPointsContainer").append(newRow);
        });

        $(document).on("click", ".removePickupPoint", function () {
            $(this).closest(".input-group").remove();
        });

        $("#submitButton").click(function (e) {
            e.preventDefault();

            let pickupPoints = [];
            let isValid = true;
            $("#pickupError").text("");

            $(".pickup-point").each(function () {
                if ($(this).val().trim() === "") {
                    isValid = false;
                    $("#pickupError").text("Pickup points cannot be empty.");
                } else {
                    pickupPoints.push($(this).val().trim());
                }
            });

            if (!isValid) return;

            $("#PointNames").val(pickupPoints.join("|"));

            Swal.fire({
                title: "Are you sure?",
                text: "Do you want to add this trip route?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, Add it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    $("#tripRouteForm").submit();
                }
            });
        });

        $("#cancelButton").click(function (e) {
            Swal.fire({
                title: "Are you sure?",
                text: "Your changes will be lost!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, Cancel!"
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("Index", "TripRoutes")';
                }
            });
        });
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
