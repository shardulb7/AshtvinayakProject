@model AshtavinayakAPP.Models.Notification

@{
    ViewData["Title"] = "Details";
}

<link href="~/CSS/category/details.css" rel="stylesheet" />

<div class="d-flex justify-content-center align-items-center">
    <div class="shadow-lg p-4 bg-white rounded" style="width: 50%;">

        <div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
            <h4>Notification Details</h4>
            <a asp-action="Index" class="close-btn" title="Back to List">❌</a>
        </div>

        <hr />

        <div class="card mt-3">
            <div class="card-body">
                <h4 class="card-title">Details</h4>

                <dl class="row">
                    <div class="col-md-12">
                        @foreach (var detail in new[] {
                        new { Name = Html.DisplayNameFor(model => model.NotificationMessage), Value = Html.DisplayFor(model => model.NotificationMessage) },
                        new { Name = Html.DisplayNameFor(model => model.NotificationDate), Value = Html.DisplayFor(model => model.NotificationDate) },
                       @*  new { Name = Html.DisplayNameFor(model => model.CreatedAt), Value = Html.DisplayFor(model => model.CreatedAt) },
                        new { Name = Html.DisplayNameFor(model => model.UpdatedAt), Value = Html.DisplayFor(model => model.UpdatedAt) },
                      *@
                        
                        
                        new { Name = Html.DisplayNameFor(model => model.Trip), Value = Html.DisplayFor(model => model.Trip.TourName) },
                        new { Name = Html.DisplayNameFor(model => model.Vehicle), Value = Html.DisplayFor(model => model.Vehicle.VehicleNumber) }

                        
                        })
                        {
                            <div class="card mb-3">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-sm-2 col-md-4">
                                            <dt>@detail.Name</dt>
                                        </div>
                                        <div class="col-sm-10 col-md-8">
                                            <dd>@detail.Value</dd>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </dl>

                <p class="mt-3 text-center">
                    <a asp-action="Edit" asp-route-id="@Model?.NotificationId" class="btn btn-primaryN">Edit</a>
                    <a asp-action="Index" class="btn btn-secondaryN">Back to List</a>
                </p>
            </div>
        </div>
    </div>
</div>
