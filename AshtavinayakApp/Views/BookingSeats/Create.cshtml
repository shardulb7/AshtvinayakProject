@model AshtavinayakAPP.Models.BookingSeat

@{
    ViewData["Title"] = "Create";
}

<link href="~/css/category/create.css" rel="stylesheet" />
<!-- Include SweetAlert CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="d-flex justify-content-center align-items-center">
    <div class="shadow-lg p-4 bg-white rounded" style="width: 50%;">

        <div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
            <h4>Create Booking Seat</h4>
            <a asp-action="Index" class="close-btn" title="Back to List">❌</a>
        </div>
        <hr />

        <form id="bookingSeatForm" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Seat Number -->
            <div class="form-group">
                <label asp-for="SeatNumber" class="control-label"></label><span style="color: red;">*</span>
                <input asp-for="SeatNumber" class="form-control" required placeholder="Enter Seat Number" />
                <span asp-validation-for="SeatNumber" class="text-danger"></span>
            </div>

            <!-- Adults -->
            <div class="form-group">
                <label asp-for="Adults" class="control-label"></label><span style="color: red;">*</span>
                <input asp-for="Adults" class="form-control" required placeholder="Enter Number of Adults" type="number" min="1" />
                <span asp-validation-for="Adults" class="text-danger"></span>
            </div>

            <!-- Child with Seat -->
            <div class="form-group">
                <label asp-for="Childwithseat" class="control-label"></label><span style="color: red;">*</span>
                <input asp-for="Childwithseat" class="form-control" required placeholder="Enter Number of Children with Seat" type="number" min="0" />
                <span asp-validation-for="Childwithseat" class="text-danger"></span>
            </div>

            <!-- Child without Seat -->
            <div class="form-group">
                <label asp-for="Childwithoutseat" class="control-label"></label><span style="color: red;">*</span>
                <input asp-for="Childwithoutseat" class="form-control" required placeholder="Enter Number of Children without Seat" type="number" min="0" />
                <span asp-validation-for="Childwithoutseat" class="text-danger"></span>
            </div>

            <!-- Trip Dropdown -->
            <div class="form-group">
                <label asp-for="TripId" class="control-label"></label><span style="color: red;">*</span>
                <select asp-for="TripId" class="form-control" asp-items="ViewBag.TripId">
                    <option value="">Select Trip</option>
                </select>
                <span asp-validation-for="TripId" class="text-danger"></span>
            </div>

            <!-- User Dropdown -->
            <div class="form-group">
                <label asp-for="UserId" class="control-label"></label><span style="color: red;">*</span>
                <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId">
                    <option value="">Select User</option>
                </select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>

            <!-- Booking ID -->
          @*   <div class="form-group">
                <label asp-for="BookingId" class="control-label"></label><span style="color: red;">*</span>
                <input asp-for="BookingId" class="form-control" required placeholder="Enter Booking ID" />
                <span asp-validation-for="BookingId" class="text-danger"></span>
            </div> *@

            <div class="form-group">
                <label asp-for="BookingId" class="control-label">Booking Date</label><span style="color: red;">*</span>
                <select asp-for="BookingId" class="form-control" asp-items="ViewBag.BookingId">
                    <option value="">Select Booking</option>
                </select>
                <span asp-validation-for="BookingId" class="text-danger"></span>
            </div>



            <!-- Submit and Cancel Buttons -->
            <div class="form-group text-center">
                <button type="button" id="submitButton" class="btn btn-secondaryN" style="background-color: dodgerblue">Create</button>
                <button type="button" id="cancelButton" class="btn btn-secondaryN">Cancel</button>
            </div>
        </form>

    </div>
</div>

<script>

    // Add event listener for validation
    document.querySelectorAll('input[type="number"]').forEach(function (input) {
        input.addEventListener('input', function (e) {
            let value = e.target.value;

            // Remove non-numeric characters (keeping digits only)
            value = value.replace(/[^0-9]/g, '');

            // Prevent negative values
            if (parseInt(value) < 0) {
                value = '';
            }

            // Update input field value
            e.target.value = value;
        });
    });


    document.getElementById('submitButton').addEventListener('click', function (e) {
        e.preventDefault();

        // Form validation check
        let seatNumber = document.getElementById('SeatNumber').value.trim();
        let adults = document.getElementById('Adults').value.trim();
        let childWithSeat = document.getElementById('Childwithseat').value.trim();
        let childWithoutSeat = document.getElementById('Childwithoutseat').value.trim();
        let tripId = document.getElementById('TripId').value;
        let userId = document.getElementById('UserId').value;
        let bookingId = document.getElementById('BookingId').value.trim();

        if (seatNumber === "" || adults === "" || childWithSeat === "" || childWithoutSeat === "" || tripId === "" || userId === "" || bookingId === "") {
            Swal.fire({
                title: "Missing Fields",
                text: "Please fill out all required fields before submitting.",
                icon: "error"
            });
            return;
        }

        // Confirmation popup
        Swal.fire({
            title: "Are you sure?",
            text: "Do you want to add this booking seat?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, Add it!"
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('bookingSeatForm').submit();
            }
        });
    });

    document.getElementById('cancelButton').addEventListener('click', function (e) {
        Swal.fire({
            title: "Are you sure?",
            text: "Your changes will be lost!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, Cancel!"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '@Url.Action("Index", "BookingSeats")';
            }
        });
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
