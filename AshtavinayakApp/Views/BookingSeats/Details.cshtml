@model AshtavinayakAPP.Models.BookingSeat

@{
    ViewData["Title"] = "Details";
}

<link href="~/CSS/category/details.css" rel="stylesheet" />

<div class="d-flex justify-content-center align-items-center">
    <div class="shadow-lg p-4 bg-white rounded" style="width: 50%;">

        <div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
            <h4>Details Booking Seat</h4>
            <a asp-action="Index" class="close-btn" title="Back to List">❌</a>
        </div>

        <hr />

        <div class="card mt-3">
            <div class="card-body">
                <h4 class="card-title">Booking Seat Details</h4>

                <dl class="row">
                    <div class="col-md-12">
                        <!-- Seat Number -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-2 col-md-4">
                                        <dt>@Html.DisplayNameFor(model => model.SeatNumber)</dt>
                                    </div>
                                    <div class="col-sm-10 col-md-8">
                                        <dd>@Html.DisplayFor(model => model.SeatNumber)</dd>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Adults -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-2 col-md-4">
                                        <dt>@Html.DisplayNameFor(model => model.Adults)</dt>
                                    </div>
                                    <div class="col-sm-10 col-md-8">
                                        <dd>@Html.DisplayFor(model => model.Adults)</dd>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Child with seat -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-2 col-md-4">
                                        <dt>@Html.DisplayNameFor(model => model.Childwithseat)</dt>
                                    </div>
                                    <div class="col-sm-10 col-md-8">
                                        <dd>@Html.DisplayFor(model => model.Childwithseat)</dd>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Child without seat -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-2 col-md-4">
                                        <dt>@Html.DisplayNameFor(model => model.Childwithoutseat)</dt>
                                    </div>
                                    <div class="col-sm-10 col-md-8">
                                        <dd>@Html.DisplayFor(model => model.Childwithoutseat)</dd>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Booking Id -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-2 col-md-4">
                                        <dt>@Html.DisplayNameFor(model => model.BookingId)</dt>
                                    </div>
                                    <div class="col-sm-10 col-md-8">
                                        <dd>@Html.DisplayFor(model => model.BookingId)</dd>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Trip Id -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-2 col-md-4">
                                        <dt>@Html.DisplayNameFor(model => model.Trip)</dt>
                                    </div>
                                    <div class="col-sm-10 col-md-8">
                                        <dd>@Html.DisplayFor(model => model.Trip.TourName)</dd>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- User Id -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-2 col-md-4">
                                        <dt>@Html.DisplayNameFor(model => model.User)</dt>
                                    </div>
                                    <div class="col-sm-10 col-md-8">
                                        <dd>@Html.DisplayFor(model => model.User.UserName)</dd>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </dl>

                <p class="mt-3 text-center">
                    <a asp-action="Edit" asp-route-id="@Model?.BookingSeatId" class="btn btn-primary">Edit</a>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </p>
            </div>
        </div>

    </div>
</div>
