@model IEnumerable<AshtavinayakAPP.Models.Booking>
@using System.Collections.Generic

@{
    ViewData["Title"] = "Bus Booking List";
    var seatNumbers      = (ViewBag.SeatNumbers      as Dictionary<int, string>)  ?? new Dictionary<int, string>();
    var adults           = (ViewBag.Adults           as Dictionary<int, int>)     ?? new Dictionary<int, int>();
    var childWithSeat    = (ViewBag.ChildWithSeat    as Dictionary<int, int>)     ?? new Dictionary<int, int>();
    var childWithoutSeat = (ViewBag.ChildWithoutSeat as Dictionary<int, int>)     ?? new Dictionary<int, int>();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link href="~/CSS/bookingindex.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div class="booking-container d-flex justify-content-between align-items-center w-100">
    <h2>Bus Booking List</h2>
    <div class="lefticons d-flex align-items-center">
        <select id="tripFilter" class="form-control" style="width: 200px; margin-right: 5px; margin-top:-16px;">
            <option value="">All Trips</option>
            @foreach (var trip in Model.Where(b => b.Trip != null).Select(b => b.Trip!.TourName).Distinct())
            {
                <option value="@trip">@trip</option>
            }
        </select>
        <input type="text" id="searchInput" placeholder="Search..."
               style="padding:5px; width:200px; margin-right:5px; display:none; border:none; margin-top:-17px;"
               onkeyup="filterTable()" />
        <p>
            <a href="javascript:void(0);" id="searchIcon" class="btn"
               style="padding:5px 10px; margin-right:5px; border:1px solid grey; background-color:white; color:black;" title='Search'>
                <i class="fas fa-search" style="color:black;"></i>
            </a>
        </p>
        <p>
            <a href="@Url.Action("Create")" class="btn btn-primary" style="padding:5px 10px;" title='Add New'>
                <i class="fas fa-plus"></i>
            </a>
        </p>
        <div class="export-container">
            <p style="margin-left:5px;">
                <a href="javascript:void(0);" class="btn btn-success" title="Export to Excel" onclick="exportToExcel()">
                    <i class="fas fa-file-excel"></i> Excel
                </a>
                <button class="btn btn-danger" onclick="exportToPDF()" title="Export to PDF">
                    <i class="fas fa-file-pdf"></i> PDF
                </button>
            </p>
        </div>
    </div>
</div>

<div class="table-container">
    <table class="table" id="bookingTable" style="font-size:0.85rem;">
        <thead>
            <tr>
                <th>Sr No</th>
                <th>Booking Date</th>
                <th>Trip Date</th>
                <th>Trip Name</th>
                <th>User Name</th>
                <th>Phone</th>
                <th>Pickup Point</th>
                <th>Drop Point</th>
                <th>Adults</th>
                <th>Child w/Seat</th>
                <th>Child w/o Seat</th>
                <th>Seat No</th>
                <th>Room Type</th>
                <th>Total Payment</th>
                <th>Advance</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                int serialNumber = 1;
            }
            @foreach (var item in Model)
            {
                string tripDisplay = item.Trip != null ? item.Trip.TourName ?? "" : "";
                int bid = item.BookingId;
                string seatNum = seatNumbers.ContainsKey(bid)      ? seatNumbers[bid]      : "-";
                string adultCt = adults.ContainsKey(bid)           ? adults[bid].ToString() : "-";
                string cwsCt   = childWithSeat.ContainsKey(bid)    ? childWithSeat[bid].ToString() : "-";
                string cwosCt  = childWithoutSeat.ContainsKey(bid) ? childWithoutSeat[bid].ToString() : "-";
                <tr data-trip="@tripDisplay.ToLower()">
                    <td>@serialNumber</td>
                    <td>@(item.BookingDate.HasValue ? item.BookingDate.Value.ToString("dd-MM-yyyy") : "NA")</td>
                    <td>@(item.Trip != null ? item.Trip.TripDate.ToString("dd-MM-yyyy") : "NA")</td>
                    <td>@(tripDisplay != "" ? tripDisplay : "NA")</td>
                    <td>@(item.User != null ? item.User.UserName : "-")</td>
                    <td>@(item.User != null ? item.User.PhoneNumber : "-")</td>
                    <td>@(item.PickupPoint != null ? item.PickupPoint.PickupPoint1 : item.PickUpPointName ?? "-")</td>
                    <td>@(item.Droppoint ?? "-")</td>
                    <td>@adultCt</td>
                    <td>@cwsCt</td>
                    <td>@cwosCt</td>
                    <td>@seatNum</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.RoomType))
                        {
                            <span class="badge bg-info text-dark">@item.RoomType</span>
                        }
                        else
                        {
                            <text>-</text>
                        }
                    </td>
                    <td>@(item.TotalPayment.HasValue ? "Rs." + item.TotalPayment.Value.ToString("N0") : "-")</td>
                    <td>@(item.Advance.HasValue ? "Rs." + item.Advance.Value.ToString("N0") : "-")</td>
                    <td>
                        <a href='@Url.Action("Edit",    new { id = item.BookingId })'><img src='~/images/edit (1).png'                   alt='Edit'    style='width:22px;height:22px;' /></a>
                        <a href='@Url.Action("Details", new { id = item.BookingId })'><img src='~/images/investigation_1723432.png' alt='Details' style='width:22px;height:22px;' /></a>
                        <a href='@Url.Action("Delete",  new { id = item.BookingId })'><img src='~/images/delete (1).png'               alt='Delete'  style='width:22px;height:22px;' /></a>
                    </td>
                </tr>
                serialNumber++;
            }
        </tbody>
    </table>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.24/jspdf.plugin.autotable.min.js"></script>

<script>
    function exportToExcel() {
        var tripFilter = document.getElementById("tripFilter").value;
        window.location.href = '@Url.Action("ExportToExcel", "Bookings")?tripFilter=' + tripFilter;
    }

    function exportToPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: 'landscape' });
        doc.text('Bus Booking List', 14, 10);
        const headers = [["Sr", "Booking Date", "Trip Date", "Trip Name", "User", "Phone", "Pickup", "Drop", "Extra adult (If any)", "CwS", "CwoS", "Seat No", "Room", "Total", "Advance"]];
        const rows = [];
        document.querySelectorAll("#bookingTable tbody tr").forEach(function(row) {
            if (row.style.display !== "none") {
                var cells = row.querySelectorAll("td");
                if (cells.length > 0) {
                    rows.push(Array.from(cells).slice(0, 15).map(function(c) { return c.innerText; }));
                }
            }
        });
        doc.autoTable({ head: headers, body: rows, startY: 16, theme: 'grid', headStyles: { fillColor: [22, 160, 133] }, styles: { fontSize: 7 } });
        doc.save('BusBookingList.pdf');
    }

    document.getElementById('searchIcon').onclick = function () {
        var s = document.getElementById('searchInput');
        s.style.display = s.style.display === 'none' ? 'block' : 'none';
        if (s.style.display === 'block') s.focus();
    };

    document.getElementById('tripFilter').onchange = function() { filterTable(); };

    function filterTable() {
        var searchInput = document.getElementById('searchInput').value.toLowerCase();
        var tripFilter  = document.getElementById('tripFilter').value.toLowerCase();
        document.querySelectorAll("#bookingTable tbody tr").forEach(function(row) {
            var tripName  = (row.getAttribute('data-trip') || '').toLowerCase();
            var text      = row.innerText.toLowerCase();
            var mSearch   = text.includes(searchInput);
            var mTrip     = !tripFilter || tripName.includes(tripFilter);
            row.style.display = mSearch && mTrip ? '' : 'none';
        });
    }
</script>
