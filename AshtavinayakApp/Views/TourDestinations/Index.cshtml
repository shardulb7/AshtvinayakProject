@model IEnumerable<AshtavinayakAPP.Models.TourDestination>

@{
    ViewData["Title"] = "Index";
}

<h1>Tour Destinations</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DestinationName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.DestinationName)</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>
                    <a href='@Url.Action("Edit", new { id = item.Id })'>
                        <img src='~/images/edit (1).png' alt='Edit' style='width: 25px; height: 25px;' />
                    </a>
                    <a href='@Url.Action("Details", new { id = item.Id })'>
                        <img src='~/images/investigation_1723432.png' alt='Details' style='width: 25px; height: 25px;' />
                    </a>
                    <a href='@Url.Action("Delete", new { id = item.Id })'>
                        <img src='~/images/delete (1).png' alt='Delete' style='width: 25px; height: 25px;' />
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
