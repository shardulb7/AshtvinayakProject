@model AshtavinayakAPP.Models.History

@{
    ViewData["Title"] = "Edit";
}

<link href="~/CSS/Category/edit.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="d-flex justify-content-center align-items-center">
    <div class="shadow-lg p-4 bg-white rounded" style="width: 50%;">

        <div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
            <h4>Edit History</h4>
            <a asp-action="Index" class="close-btn" title="Back to List">❌</a>
        </div>
        <hr />

        <form id="historyForm" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="HistoryId" />

            <div class="form-horizontal">
                <div class="form-group">
                    <label asp-for="CityId" class="control-label">City</label><span style="color:red;">*</span>
                    <select asp-for="CityId" class="form-control" asp-items="ViewBag.CityId" required>
                        <option value="" disabled selected>Select City</option>
                    </select>
                    <span asp-validation-for="CityId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PackageId" class="control-label">Package</label><span style="color:red;">*</span>
                    <select asp-for="PackageId" class="form-control" asp-items="ViewBag.PackageId" required>
                        <option value="" disabled selected>Select Package</option>
                    </select>
                    <span asp-validation-for="PackageId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CategoryId" class="control-label">Category</label><span style="color:red;">*</span>
                    <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId" required>
                        <option value="" disabled selected>Select Category</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BookingId" class="control-label">Booking</label><span style="color:red;">*</span>
                    <select asp-for="BookingId" class="form-control" asp-items="ViewBag.BookingId" required>
                        <option value="" disabled selected>Select Booking</option>
                    </select>
                    <span asp-validation-for="BookingId" class="text-danger"></span>
                </div>

                <div class="form-group text-center">
                    <button type="button" id="submitButton" class="btn btn-secondaryN" style="background-color: dodgerblue">Update</button>
                    <button type="button" id="cancelButton" class="btn btn-secondaryN" style="background-color:red;">Cancel</button>
                </div>
            </div>
        </form>

    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>

    $(document).ready(function () {
        $('#CityId').change(function () {
            var cityId = $(this).val();
            if (cityId) {
                $.ajax({
                    url: '@Url.Action("GetPackagesByCity", "TripRoutes")',
                    type: 'GET',
                    data: { cityId: cityId },
                    success: function (data) {
                        var packageDropdown = $('#PackageId');
                        packageDropdown.empty();
                        packageDropdown.append('<option value="" disabled selected>Select Package</option>');
                        $.each(data, function (index, package) {
                            packageDropdown.append($('<option></option>').val(package.packageId).text(package.packageName));
                        });
                    },
                    error: function () {
                        alert('Failed to load packages. Please try again.');
                    }
                });
            }
        });
    });


    document.getElementById('submitButton').addEventListener('click', function (e) {
        e.preventDefault();

        var form = document.getElementById('historyForm');
        if (form.checkValidity()) {
            Swal.fire({
                title: "Are you sure?",
                text: "Do you want to update this history record?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, Save it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        } else {
            form.reportValidity(); // Triggers built-in validation messages
        }
    });

    document.getElementById('cancelButton').addEventListener('click', function (e) {
        Swal.fire({
            title: "Are you sure?",
            text: "Your changes will be lost!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, Cancel!"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '@Url.Action("Index", "Histories")';
            }
        });
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
