@model AshtavinayakAPP.Models.History

@{
    ViewData["Title"] = "Delete";
}

<link href="~/css/category/delete.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="d-flex justify-content-center align-items-center">
    <div class="shadow-lg p-4 bg-white rounded" style="width: 50%;">

        <div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
            <h4>Delete History</h4>
            <a asp-action="Index" class="close-btn" title="Back to List">❌</a>
        </div>

        <hr />

        <div class="card mt-3">
            <div class="card-body">
                <h3 class="card-title">Are you sure you want to delete this?</h3>
                <h4>History Details</h4>
                <hr />

                <dl class="row">
                    <div class="col-md-4">
                        <dt>@Html.DisplayNameFor(model => model.Booking)</dt>
                    </div>
                    <div class="col-md-8">
                        <dd>@Html.DisplayFor(model => model.Booking.BookingId)</dd>
                    </div>
                    <div class="col-md-4">
                        <dt>@Html.DisplayNameFor(model => model.Category)</dt>
                    </div>
                    <div class="col-md-8">
                        <dd>@Html.DisplayFor(model => model.Category.CategoryName)</dd>
                    </div>
                    <div class="col-md-4">
                        <dt>@Html.DisplayNameFor(model => model.City)</dt>
                    </div>
                    <div class="col-md-8">
                        <dd>@Html.DisplayFor(model => model.City.CityName)</dd>
                    </div>
                    <div class="col-md-4">
                        <dt>@Html.DisplayNameFor(model => model.Package)</dt>
                    </div>
                    <div class="col-md-8">
                        <dd>@Html.DisplayFor(model => model.Package.PackageName)</dd>
                    </div>
                </dl>

                <form id="deleteForm" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="HistoryId" />
                    <div class="form-actions text-center">
                        <input type="submit" value="Delete" class="btn-secondaryN" style="background-color:dodgerblue;" id="deleteButton" />
                        <button type="button" id="cancelButton" class="btn-secondaryN" style="background-color:red;">Cancel</button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

<a href="@Url.Action("Index", "History")" class="close-btn" title="Back to List" style="position: absolute; top: 10px; right: 10px; font-size: 20px; background: none; border: none; color: black;">❌</a>

@section Scripts {
    <script>
        // Event listener for Delete button
        document.getElementById('deleteButton').addEventListener('click', function (e) {
            e.preventDefault(); // Prevent the form from being submitted immediately

            // Show confirmation dialog
            var userConfirmed = confirm("Are you sure you want to delete this history?");

            // If the user confirms, submit the form
            if (userConfirmed) {
                document.getElementById('deleteForm').submit();
            } else {
                window.location.href = '@Url.Action("Index", "Histories")';
            }
        });

        // Event listener for Cancel button
        document.getElementById('cancelButton').addEventListener('click', function (e) {
            e.preventDefault(); // Prevent the default action

            // Show confirmation dialog for canceling
            Swal.fire({
                title: "Are you sure?",
                text: "Your changes will be lost!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, Cancel!"
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("Index", "History")'; // Redirect if confirmed
                }
            });
        });
    </script>
}
