@model AshtavinayakAPP.Models.Agent

@{
    ViewData["Title"] = "Agent Details";
}

<link href="~/CSS/category/details.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<div class="d-flex justify-content-center align-items-center">
    <div class="shadow-lg p-4 bg-white rounded" style="width: 60%;">

        <div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
            <h4>Agent Details</h4>
            <a asp-action="Index" class="close-btn" title="Back to List">❌</a>
        </div>

        <hr />

        <div class="card mt-3">
            <div class="card-body">
                <h4 class="card-title">Agent Information</h4>
                <hr />

                <dl class="row">
                    <div class="col-md-12">
                        <div class="card mb-3"><div class="card-body"><div class="row">
                            <div class="col-sm-2 col-md-4"><dt>@Html.DisplayNameFor(m => m.FullName)</dt></div>
                            <div class="col-sm-10 col-md-8"><dd>@Html.DisplayFor(m => m.FullName)</dd></div>
                        </div></div></div>

                        <div class="card mb-3"><div class="card-body"><div class="row">
                            <div class="col-sm-2 col-md-4"><dt>@Html.DisplayNameFor(m => m.BusinessName)</dt></div>
                            <div class="col-sm-10 col-md-8"><dd>@Html.DisplayFor(m => m.BusinessName)</dd></div>
                        </div></div></div>

                        <div class="card mb-3"><div class="card-body"><div class="row">
                            <div class="col-sm-2 col-md-4"><dt>@Html.DisplayNameFor(m => m.MobileNumber)</dt></div>
                            <div class="col-sm-10 col-md-8"><dd>@Html.DisplayFor(m => m.MobileNumber)</dd></div>
                        </div></div></div>

                        <div class="card mb-3"><div class="card-body"><div class="row">
                            <div class="col-sm-2 col-md-4"><dt>@Html.DisplayNameFor(m => m.Email)</dt></div>
                            <div class="col-sm-10 col-md-8"><dd>@Html.DisplayFor(m => m.Email)</dd></div>
                        </div></div></div>

                        <div class="card mb-3"><div class="card-body"><div class="row">
                            <div class="col-sm-2 col-md-4"><dt>@Html.DisplayNameFor(m => m.Address)</dt></div>
                            <div class="col-sm-10 col-md-8"><dd>@Html.DisplayFor(m => m.Address)</dd></div>
                        </div></div></div>

                        <div class="card mb-3"><div class="card-body"><div class="row">
                            <div class="col-sm-2 col-md-4"><dt>Approval Status</dt></div>
                            <div class="col-sm-10 col-md-8"><dd>@Model.ApprovalStatus</dd></div>
                        </div></div></div>

                        <div class="card mb-3"><div class="card-body"><div class="row">
                            <div class="col-sm-2 col-md-4"><dt>Active</dt></div>
                            <div class="col-sm-10 col-md-8"><dd>@(Model.IsActive ? "Yes" : "No")</dd></div>
                        </div></div></div>

                        @if (!string.IsNullOrWhiteSpace(Model.RejectionRemarks))
                        {
                            <div class="card mb-3"><div class="card-body"><div class="row">
                                <div class="col-sm-2 col-md-4"><dt>Rejection Remarks</dt></div>
                                <div class="col-sm-10 col-md-8"><dd>@Model.RejectionRemarks</dd></div>
                            </div></div></div>
                        }

                        <div class="card mb-3"><div class="card-body"><div class="row">
                            <div class="col-sm-2 col-md-4"><dt>Commission Override</dt></div>
                            <div class="col-sm-10 col-md-8">
                                <dd>@(Model.CommissionPercentage.HasValue ? Model.CommissionPercentage.Value + "%" : "None (uses default)")</dd>
                            </div>
                        </div></div></div>

                        <div class="card mb-3">
                            <div class="card-body">
                                <h5 class="card-title">Documents</h5>
                                <a class="btn btn-secondaryN" style="background-color:dodgerblue;" target="_blank"
                                   href="@Url.Action("DownloadDocument", new { agentId = Model.AgentId, documentType = "aadhaar" })">Aadhaar Card</a>
                                <a class="btn btn-secondaryN" style="background-color:dodgerblue;" target="_blank"
                                   href="@Url.Action("DownloadDocument", new { agentId = Model.AgentId, documentType = "shopact" })">Shop Act License</a>
                                <a class="btn btn-secondaryN" style="background-color:dodgerblue;" target="_blank"
                                   href="@Url.Action("DownloadDocument", new { agentId = Model.AgentId, documentType = "udyam" })">Udyam Certificate</a>
                            </div>
                        </div>
                    </div>
                </dl>
            </div>
        </div>

        <div class="text-center mt-3">
            @if (Model.ApprovalStatus == "Pending")
            {
                <form asp-action="Approve" asp-route-id="@Model.AgentId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primaryN">Approve</button>
                </form>
                <button type="button" class="btn btn-secondaryN" style="background-color:red;" id="rejectButton">Reject</button>
            }
            else
            {
                <form asp-action="ToggleActive" asp-route-id="@Model.AgentId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-secondaryN" style="background-color:dodgerblue;">
                        @(Model.IsActive ? "Deactivate" : "Activate")
                    </button>
                </form>
            }
            <a asp-action="Edit" asp-route-id="@Model.AgentId" class="btn btn-primaryN">Set Commission</a>
            <a asp-action="Index" class="btn btn-secondaryN">Back to List</a>
        </div>

        @if (Model.ApprovalStatus == "Pending")
        {
            <form asp-action="Reject" asp-route-id="@Model.AgentId" method="post" id="rejectForm" class="mt-3" style="display:none;">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Rejection Remarks (optional)</label>
                    <textarea name="remarks" class="form-control" rows="2"></textarea>
                </div>
                <div class="text-center mt-2">
                    <button type="submit" class="btn btn-secondaryN" style="background-color:red;">Confirm Reject</button>
                </div>
            </form>
        }

    </div>
</div>

<script>
    var rejectButton = document.getElementById('rejectButton');
    if (rejectButton) {
        rejectButton.addEventListener('click', function () {
            document.getElementById('rejectForm').style.display = 'block';
            rejectButton.style.display = 'none';
        });
    }
</script>
