@model AshtavinayakAPP.Models.Agent

@{
    ViewData["Title"] = "Set Commission";
}

<link href="~/CSS/Category/edit.css" rel="stylesheet" />

<div class="d-flex justify-content-center align-items-center">
    <div class="shadow-lg p-4 bg-white rounded" style="width: 50%;">

        <div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
            <h4>Set Commission — @Model.FullName</h4>
            <a asp-action="Details" asp-route-id="@Model.AgentId" class="close-btn" title="Back">❌</a>
        </div>
        <hr />

        <form asp-action="Edit" asp-route-id="@Model.AgentId" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Per-Agent Commission Percentage</label>
                <input type="number" step="0.01" min="0" max="100" name="commissionPercentage"
                       class="form-control" value="@Model.CommissionPercentage" placeholder="Leave blank to use the default commission %" />
                <small class="text-muted">Leave blank to fall back to the default commission percentage configured in Commission Settings.</small>
            </div>

            <div class="form-group text-center mt-3">
                <button type="submit" class="btn btn-secondaryN" style="background-color:dodgerblue">Save</button>
                <a asp-action="Details" asp-route-id="@Model.AgentId" class="btn btn-secondaryN">Cancel</a>
            </div>
        </form>

    </div>
</div>
