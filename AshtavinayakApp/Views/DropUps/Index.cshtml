@model IEnumerable<AshtavinayakAPP.Models.DropUp>

@{
    ViewData["Title"] = "Drop Point List";
    // Group by Package
    var groups = Model
        .GroupBy(d => new { PackageName = d.Package?.PackageName ?? "—", CityName = d.City?.CityName ?? "—", d.PackageId })
        .OrderBy(g => g.Key.PackageName)
        .ToList();
}

<link href="~/CSS/Category/index.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<style>
    .pkg-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f0f7f0;
        border: 1px solid #c8dfc8;
        border-radius: 8px;
        padding: 10px 16px;
        margin-bottom: 6px;
        cursor: pointer;
        transition: background 0.2s;
        user-select: none;
    }
    .pkg-header:hover { background: #e0f0e0; }
    .pkg-header.open   { background: #d4ecd4; border-color: #9ec89e; border-radius: 8px 8px 0 0; margin-bottom: 0; }
    .pkg-header-left   { display: flex; align-items: center; gap: 10px; }
    .pkg-name          { font-weight: 600; font-size: 1rem; color: #1a4d1a; }
    .pkg-city          { font-size: 0.82rem; color: #555; background: #c8e8c8; padding: 2px 8px; border-radius: 20px; }
    .pkg-count         { font-size: 0.82rem; color: #666; }
    .chevron           { font-size: 1rem; color: #555; transition: transform 0.25s; }
    .open .chevron     { transform: rotate(90deg); }
    .pkg-body          { border: 1px solid #c8dfc8; border-top: none; border-radius: 0 0 8px 8px; margin-bottom: 14px; overflow: hidden; }
    .pkg-body table    { margin: 0; }
    .pkg-body thead th { background: #f5fbf5; font-size: 0.88rem; padding: 8px 12px; }
    .pkg-body tbody td { font-size: 0.9rem; padding: 7px 12px; vertical-align: middle; }
    .pkg-body tbody tr:last-child td { border-bottom: none; }
    .no-results        { text-align: center; color: #999; padding: 40px; }
</style>

<div class="d-flex justify-content-between align-items-center w-100 mb-3">
    <h2>Drop Point List</h2>
    <div class="lefticons d-flex align-items-center gap-2">
        <!-- Search -->
        <input type="text" id="searchInput" placeholder="Search..." oninput="filterGroups()"
               style="padding:5px 10px; width:200px; border:1px solid #ccc; border-radius:6px; display:none;" />
        <a href="javascript:void(0);" id="searchIcon" class="btn"
           style="padding:5px 10px; border:1px solid grey; background:white;">
            <i class="fas fa-search" style="color:black;"></i>
        </a>
        <!-- Expand / Collapse All -->
        <button class="btn btn-outline-secondary btn-sm" title="Expand all" onclick="toggleAll(true)">
            <i class="fas fa-expand-alt"></i> All
        </button>
        <button class="btn btn-outline-secondary btn-sm" title="Collapse all" onclick="toggleAll(false)">
            <i class="fas fa-compress-alt"></i>
        </button>
        <!-- Add -->
        <a href="@Url.Action("Create")" class="btn btn-primary" style="padding:5px 10px;" title="Add New">
            <i class="fas fa-plus"></i>
        </a>
    </div>
</div>

@if (!groups.Any())
{
    <div class="no-results">No drop points found. Click <strong>+</strong> to add some.</div>
}

@foreach (var group in groups)
{
    var groupId = "pkg-" + (group.Key.PackageId?.ToString() ?? "none");
    <div class="pkg-group" data-package="@group.Key.PackageName.ToLower()" data-city="@group.Key.CityName.ToLower()">

        <div class="pkg-header" onclick="toggleGroup('@groupId', this)">
            <div class="pkg-header-left">
                <span class="chevron">▶</span>
                <span class="pkg-name">@group.Key.PackageName</span>
                <span class="pkg-city">@group.Key.CityName</span>
            </div>
            <span class="pkg-count">@group.Count() drop point@(group.Count() != 1 ? "s" : "")</span>
        </div>

        <div class="pkg-body" id="@groupId" style="display:none;">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Drop Point</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rowNum = 1; }
                    @foreach (var item in group)
                    {
                        <tr class="drop-row" data-point="@item.DropPoint?.ToLower()">
                            <td>@rowNum</td>
                            <td>@item.DropPoint</td>
                            <td>
                                <a href='@Url.Action("Edit", new { id = item.DroppointId })'>
                                    <img src='~/images/edit (1).png' alt='Edit' style='width:22px;height:22px;' />
                                </a>
                                <a href='@Url.Action("Details", new { id = item.DroppointId })'>
                                    <img src='~/images/investigation_1723432.png' alt='Details' style='width:22px;height:22px;' />
                                </a>
                                <a href='@Url.Action("Delete", new { id = item.DroppointId })'>
                                    <img src='~/images/delete (1).png' alt='Delete' style='width:22px;height:22px;' />
                                </a>
                            </td>
                        </tr>
                        rowNum++;
                    }
                </tbody>
            </table>
        </div>

    </div>
}

<script>
    // Toggle individual group
    function toggleGroup(id, header) {
        var body = document.getElementById(id);
        var isOpen = body.style.display !== 'none';
        body.style.display = isOpen ? 'none' : 'block';
        header.classList.toggle('open', !isOpen);
    }

    // Expand / Collapse all
    function toggleAll(expand) {
        document.querySelectorAll('.pkg-body').forEach(function (b) { b.style.display = expand ? 'block' : 'none'; });
        document.querySelectorAll('.pkg-header').forEach(function (h) { h.classList.toggle('open', expand); });
    }

    // Search — filters groups and rows
    function filterGroups() {
        var q = document.getElementById('searchInput').value.toLowerCase().trim();
        document.querySelectorAll('.pkg-group').forEach(function (group) {
            var pkgName  = group.dataset.package || '';
            var cityName = group.dataset.city    || '';
            var rows     = group.querySelectorAll('.drop-row');
            var anyVisible = false;

            rows.forEach(function (row) {
                var point = row.dataset.point || '';
                var match = !q || pkgName.includes(q) || cityName.includes(q) || point.includes(q);
                row.style.display = match ? '' : 'none';
                if (match) anyVisible = true;
            });

            group.style.display = anyVisible ? '' : 'none';
            if (anyVisible && q) {
                // Auto-open matching groups when searching
                group.querySelector('.pkg-body').style.display   = 'block';
                group.querySelector('.pkg-header').classList.add('open');
            }
        });
    }

    // Search icon toggle
    document.getElementById('searchIcon').onclick = function () {
        var inp = document.getElementById('searchInput');
        inp.style.display = inp.style.display === 'none' ? 'inline-block' : 'none';
        if (inp.style.display === 'inline-block') inp.focus();
    };
</script>
