@model AshtavinayakAPP.Models.Seat

@{
    ViewData["Title"] = "Details";
}

<link href="~/CSS/Category/details.css" rel="stylesheet" />

<div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
    <h4>Details Seat</h4>
    <a asp-action="Index" class="close-btn" title="Back to List">❌</a>
</div>


<div class="card mt-3">
    <div class="card-body">
        <h4 class="card-title">Details</h4>
        <hr />

        <dl class="row">
            <div class="col-md-12">
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-2 col-md-4">
                                <dt>@Html.DisplayNameFor(model => model.SeatNumber)</dt>
                            </div>
                            <div class="col-sm-10 col-md-8">
                                <dd>@Html.DisplayFor(model => model.SeatNumber)</dd>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-2 col-md-4">
                                <dt>@Html.DisplayNameFor(model => model.IsAvailable)</dt>
                            </div>
                            <div class="col-sm-10 col-md-8">
                                <dd>@Html.DisplayFor(model => model.IsAvailable)</dd>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-2 col-md-4">
                                <dt>@Html.DisplayNameFor(model => model.Package)</dt>
                            </div>
                            <div class="col-sm-10 col-md-8">
                                <dd>@Html.DisplayFor(model => model.Package.PackageName)</dd>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </dl>
    </div>
</div>

<p class="mt-3 text-center">
    <a asp-action="Edit" asp-route-id="@Model?.SeatId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>
