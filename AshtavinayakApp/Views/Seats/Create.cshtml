@model AshtavinayakAPP.Models.Seat

@{
    ViewData["Title"] = "Create";
}

<link href="~/css/category/create.css" rel="stylesheet" />
<!-- SweetAlert CSS -->
<div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
    <h4>Create Seat</h4>
    <a asp-action="Index" class="close-btn" title="Back to List">❌</a>
</div>

<hr />

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- Package Dropdown -->
    <div class="form-group">
        <label asp-for="PackageId" class="control-label"></label>
        <select asp-for="PackageId" class="form-control" asp-items="ViewBag.PackageId"></select>
    </div>
    <div class="form-group">
        <label asp-for="TripId" class="control-label"></label>
        <select asp-for="TripId" class="form-control" asp-items="ViewBag.TripId"></select>
    </div>

    <!-- Seat Number Input -->
    <div class="form-group">
        <label asp-for="SeatNumber" class="control-label"></label>
        <input asp-for="SeatNumber" class="form-control" required placeholder="Enter Seat Number" />
        <span asp-validation-for="SeatNumber" class="text-danger"></span>
    </div>

    <!-- Availability Checkbox -->
    <div class="form-group form-check">
        <label class="form-check-label">
            <input class="form-check-input" asp-for="IsAvailable" /> @Html.DisplayNameFor(model => model.IsAvailable)
        </label>
    </div>

    <!-- Submit and Cancel Buttons -->
    <div class="form-group text-center">
        <input type="submit" value="Create" class="btn btn-secondaryN" style="background-color:dodgerblue" />
        <button type="reset" class="btn btn-secondaryN" id="cancelButton">Cancel</button>
    </div>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Event listener for Cancel button
        document.getElementById('cancelButton').addEventListener('click', function (e) {
            e.preventDefault(); // Prevent the default reset action

            // Redirect to Index page
            window.location.href = '@Url.Action("Index", "Seats")';
        });
    </script>
}