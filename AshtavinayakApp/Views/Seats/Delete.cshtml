@model AshtavinayakAPP.Models.Seat

@{
    ViewData["Title"] = "Delete";
}

<link href="~/CSS/Category/delete.css" rel="stylesheet" />

<div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
    <h4>Delete Seat</h4>
    <a asp-action="Index" class="close-btn" title="Back to List">❌</a>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h3 class="card-title">Are you sure you want to delete this?</h3>
        <h4>Seat</h4>
        <hr />

        <dl class="dl-horizontal">
            <div class="row mb-3">
                <div class="col-md-4">
                    <dt>@Html.DisplayNameFor(model => model.SeatNumber)</dt>
                </div>
                <div class="col-md-8">
                    <dd>@Html.DisplayFor(model => model.SeatNumber)</dd>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <dt>@Html.DisplayNameFor(model => model.IsAvailable)</dt>
                </div>
                <div class="col-md-8">
                    <dd>@Html.DisplayFor(model => model.IsAvailable)</dd>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <dt>@Html.DisplayNameFor(model => model.Package)</dt>
                </div>
                <div class="col-md-8">
                    <dd>@Html.DisplayFor(model => model.Package.PackageName)</dd>
                </div>
            </div>
        </dl>

        @using (Html.BeginForm("Delete", "Seats", FormMethod.Post, new { id = "deleteForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.SeatId)

            <div class="form-actions text-center">
                <input type="submit" value="Delete" class="btn-secondaryN" id="deleteButton" />
                <button type="button" id="cancelButton" style="background-color:dodgerblue;" class="btn-secondaryN">Cancel</button>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Event listener for Delete button
        document.getElementById('deleteButton').addEventListener('click', function (e) {
            e.preventDefault(); // Prevent the form from being submitted immediately

            // Show confirmation dialog
            var userConfirmed = confirm("Are you sure you want to delete this seat?");

            // If the user confirms, submit the form
            if (userConfirmed) {
                document.getElementById('deleteForm').submit();
            } else {
                window.location.href = '@Url.Action("Index", "Seats")';
            }
        });

        // Event listener for Cancel button
        document.getElementById('cancelButton').addEventListener('click', function (e) {
            e.preventDefault(); // Prevent the default action

            // Redirect to index page or wherever necessary
            window.location.href = '@Url.Action("Index", "Seats")';
        });
    </script>
}
