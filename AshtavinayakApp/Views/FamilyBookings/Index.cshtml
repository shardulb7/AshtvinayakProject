@model IEnumerable<AshtavinayakAPP.Models.FamilyBooking>

@{
    ViewData["Title"] = "Car Booking List";
}

<link href="~/CSS/Category/index.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div class="d-flex justify-content-between align-items-center w-100">
    <h2>Car Booking List</h2>
    <div class="lefticons d-flex align-items-center">
        <input type="text" id="searchInput" placeholder="Search..."
               style="padding:5px; width:200px; margin-right:5px; display:none; border:none; margin-top:-17px;"
               onkeyup="filterTable()" />
        <p>
            <a href="javascript:void(0);" id="searchIcon" class="btn"
               style="padding:5px 10px; margin-right:5px; border:1px solid grey; background-color:white; color:black;" title='Search'>
                <i class="fas fa-search" style="color:black;"></i>
            </a>
        </p>
        <p>
            <a href="@Url.Action("Create")" class="btn btn-primary" style="padding:5px 10px;" title='Add New'>
                <i class="fas fa-plus"></i>
            </a>
        </p>
    </div>
</div>

<div class="table-container">
    <table class="table" id="carBookingTable" style="font-size:0.85rem;">
        <thead>
            <tr>
                <th>Sr No</th>
                <th>Booking Date</th>
                <th>Trip Date</th>
                <th>Pickup Time</th>
                <th>Trip Name</th>
                <th>Car Type</th>
                <th>User Name</th>
                <th>Phone</th>
                <th>Pickup Point</th>
                <th>Extra adult (If any)</th>
                <th>Extra kid (With seat- if any)</th>
                <th>Extra kid (Without seat- if any)</th>
                <th>Total Payment</th>
                <th>Advance</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                int serialNumber = 1;
            }
            @foreach (var item in Model)
            {
                string totalPay = item.TotalPayment.HasValue ? "Rs." + item.TotalPayment.Value.ToString("N0") : "-";
                string adv      = item.Advance.HasValue      ? "Rs." + item.Advance.Value.ToString("N0")      : "-";
                <tr>
                    <td>@serialNumber</td>
                    <td>@(item.BookingDate.HasValue ? item.BookingDate.Value.ToString("dd-MM-yyyy") : "NA")</td>
                    <td>@item.Date.ToString("dd-MM-yyyy")</td>
                    <td>@item.Time.ToString("hh:mm tt")</td>
                    <td>@(item.Package != null ? item.Package.PackageName : "-")</td>
                    <td>@item.CarType</td>
                    <td>@(item.User != null ? item.User.UserName : "-")</td>
                    <td>@(item.User != null ? item.User.PhoneNumber : "-")</td>
                    <td>@(item.PickupPoint ?? "-")</td>
                    <td>@(item.Adults ?? 0)</td>
                    <td>@(item.Childwithseat ?? 0)</td>
                    <td>@(item.Childwithoutseat ?? 0)</td>
                    <td>@totalPay</td>
                    <td>@adv</td>
                    <td>
                        <a href='@Url.Action("Edit",    new { id = item.FamilyId })'><img src='~/images/edit (1).png'                   alt='Edit'    style='width:22px;height:22px;' /></a>
                        <a href='@Url.Action("Details", new { id = item.FamilyId })'><img src='~/images/investigation_1723432.png' alt='Details' style='width:22px;height:22px;' /></a>
                        <a href='@Url.Action("Delete",  new { id = item.FamilyId })'><img src='~/images/delete (1).png'               alt='Delete'  style='width:22px;height:22px;' /></a>
                    </td>
                </tr>
                serialNumber++;
            }
        </tbody>
    </table>

    <div class="pagination">
        @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"] > 1)
        {
            <a href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"] - 1 })">Previous</a>
        }
        @for (int i = 1; i <= (int)ViewData["TotalPages"]; i++)
        {
            <a href="@Url.Action("Index", new { page = i })" class="@(i == (int)ViewData["CurrentPage"] ? "active" : "")">@i</a>
        }
        @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"] < (int)ViewData["TotalPages"])
        {
            <a href="@Url.Action("Index", new { page = (int)ViewData["CurrentPage"] + 1 })">Next</a>
        }
    </div>
</div>

<script>
    document.getElementById('searchIcon').onclick = function () {
        var s = document.getElementById('searchInput');
        s.style.display = s.style.display === 'none' ? 'block' : 'none';
        if (s.style.display === 'block') s.focus();
    };

    function filterTable() {
        var input = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll("#carBookingTable tbody tr").forEach(function(row) {
            row.style.display = row.innerText.toLowerCase().includes(input) ? '' : 'none';
        });
    }
</script>
