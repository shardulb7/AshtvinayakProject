@model AshtavinayakAPP.Models.FamilyBooking

@{
    ViewData["Title"] = "Edit";
}

<link href="~/CSS/Category/edit.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="d-flex justify-content-center align-items-center">
    <div class="shadow-lg p-4 bg-white rounded" style="width: 60%;">
        <div class="col-sm-12 col-md-12 col-lg-12 d-flex justify-content-between align-items-center">
            <h4>Edit Car Booking</h4>
            <a asp-action="Index" class="close-btn" title="Back to List">❌</a>
        </div>
        <hr />

        <form id="FamilyBookingForm" asp-action="Edit">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" asp-for="FamilyId" />
            <input type="hidden" asp-for="BookingId" />
            <input type="hidden" asp-for="IsDeleted" />

            <div class="row">
                <!-- User -->
                <div class="form-group col-md-6 mb-2">
                    <label asp-for="UserId" class="control-label">User Name<span style="color:red;">*</span></label>
                    <select asp-for="UserId" class="form-control" asp-items="ViewBag.UserId" required>
                        <option value="" disabled>Select User</option>
                    </select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>
                <!-- Package / Trip Name -->
                <div class="form-group col-md-6 mb-2">
                    <label asp-for="PackageId" class="control-label">Trip (Tour) Name<span style="color:red;">*</span></label>
                    <select asp-for="PackageId" class="form-control" asp-items="ViewBag.PackageId" required>
                        <option value="" disabled>Select Package</option>
                    </select>
                    <span asp-validation-for="PackageId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <!-- Car Type -->
                <div class="form-group col-md-6 mb-2">
                    <label asp-for="CarType" class="control-label">Car Type<span style="color:red;">*</span></label>
                    <input asp-for="CarType" class="form-control" required placeholder="Enter Car Type" />
                    <span asp-validation-for="CarType" class="text-danger"></span>
                </div>
                <!-- Booking Date -->
                <div class="form-group col-md-6 mb-2">
                    <label asp-for="BookingDate" class="control-label">Booking Date</label>
                    <input asp-for="BookingDate" class="form-control" type="date" />
                    <span asp-validation-for="BookingDate" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <!-- Trip Date -->
                <div class="form-group col-md-6 mb-2">
                    <label asp-for="Date" class="control-label">Trip Date<span style="color:red;">*</span></label>
                    <input asp-for="Date" class="form-control" type="date" required />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>
                <!-- Pickup Time -->
                <div class="form-group col-md-6 mb-2">
                    <label asp-for="Time" class="control-label">Pickup Time<span style="color:red;">*</span></label>
                    <input asp-for="Time" class="form-control" type="time" required />
                    <span asp-validation-for="Time" class="text-danger"></span>
                </div>
            </div>

            <!-- Pickup Point -->
            <div class="form-group mb-2">
                <label asp-for="PickupPoint" class="control-label">Pickup Point</label>
                <input asp-for="PickupPoint" class="form-control" placeholder="Enter Pickup Point" />
                <span asp-validation-for="PickupPoint" class="text-danger"></span>
            </div>

            <div class="row">
                <!-- Extra Adult -->
                <div class="form-group col-md-4 mb-2">
                    <label asp-for="Adults" class="control-label">Extra adult (If any)</label>
                    <input asp-for="Adults" class="form-control" type="number" min="0" placeholder="0" />
                    <span asp-validation-for="Adults" class="text-danger"></span>
                </div>
                <!-- Extra Kid With Seat -->
                <div class="form-group col-md-4 mb-2">
                    <label asp-for="Childwithseat" class="control-label">Extra kid (With seat- if any)</label>
                    <input asp-for="Childwithseat" class="form-control" type="number" min="0" placeholder="0" />
                    <span asp-validation-for="Childwithseat" class="text-danger"></span>
                </div>
                <!-- Extra Kid Without Seat -->
                <div class="form-group col-md-4 mb-2">
                    <label asp-for="Childwithoutseat" class="control-label">Extra kid (Without seat- if any)</label>
                    <input asp-for="Childwithoutseat" class="form-control" type="number" min="0" placeholder="0" />
                    <span asp-validation-for="Childwithoutseat" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <!-- Total Payment -->
                <div class="form-group col-md-6 mb-2">
                    <label asp-for="TotalPayment" class="control-label">Total Payment</label>
                    <input asp-for="TotalPayment" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                    <span asp-validation-for="TotalPayment" class="text-danger"></span>
                </div>
                <!-- Advance Payment -->
                <div class="form-group col-md-6 mb-2">
                    <label asp-for="Advance" class="control-label">Advance Payment</label>
                    <input asp-for="Advance" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                    <span asp-validation-for="Advance" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group text-center mt-3">
                <button type="button" id="submitButton" class="btn btn-secondaryN" style="background-color:dodgerblue">Update</button>
                <button type="button" id="cancelButton" class="btn btn-secondaryN">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('submitButton').addEventListener('click', function (e) {
        var form = document.getElementById('FamilyBookingForm');
        if (form.checkValidity()) {
            Swal.fire({
                title: "Are you sure?",
                text: "Do you want to update this car booking?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, Save it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        } else {
            form.reportValidity();
        }
    });

    document.getElementById('cancelButton').addEventListener('click', function (e) {
        Swal.fire({
            title: "Are you sure?",
            text: "Your changes will be lost!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, Cancel!"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '@Url.Action("Index", "FamilyBookings")';
            }
        });
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
