@model IEnumerable<AshtavinayakAPP.Models.AgentBookingReportRow>

@{
    ViewData["Title"] = "Agent Bookings";
}

<link href="~/CSS/Category/index.css" rel="stylesheet" />

<div class="d-flex justify-content-between align-items-center w-100">
    <h2>Agent Bookings</h2>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label">From</label>
        <input type="date" name="fromDate" class="form-control" value="@ViewData["FromDate"]" />
    </div>
    <div class="col-auto">
        <label class="form-label">To</label>
        <input type="date" name="toDate" class="form-control" value="@ViewData["ToDate"]" />
    </div>
    <div class="col-auto">
        <label class="form-label">Agent Name</label>
        <input type="text" name="agentName" class="form-control" placeholder="Agent name" value="@ViewData["AgentName"]" />
    </div>
    <div class="col-auto">
        <label class="form-label">Booking Status</label>
        <input type="text" name="bookingStatus" class="form-control" placeholder="e.g. Confirmed" value="@ViewData["BookingStatus"]" />
    </div>
    <div class="col-auto">
        <label class="form-label">Payment Status</label>
        <input type="text" name="paymentStatus" class="form-control" placeholder="e.g. Paid" value="@ViewData["PaymentStatus"]" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>
</form>

<div class="table-container">
    <table class="table" id="agentBookingsTable">
        <thead>
            <tr>
                <th>Booking ID</th>
                <th>Booking Date</th>
                <th>Agent Name</th>
                <th>Customer Name</th>
                <th>Package/Service</th>
                <th>Total Amount</th>
                <th>Commission %</th>
                <th>Commission Amount</th>
                <th>Net Paid by Agent</th>
                <th>Booking Status</th>
                <th>Payment Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.BookingId</td>
                    <td>@(row.BookingDate?.ToString("dd-MM-yyyy") ?? "-")</td>
                    <td>@row.AgentName</td>
                    <td>@row.CustomerName</td>
                    <td>@row.PackageOrService</td>
                    <td>@row.TotalBookingAmount.ToString("N2")</td>
                    <td>@row.CommissionPercentage.ToString("N2")%</td>
                    <td>@row.CommissionAmount.ToString("N2")</td>
                    <td>@row.NetAmountPaidByAgent.ToString("N2")</td>
                    <td>@(row.BookingStatus ?? "-")</td>
                    <td>@(row.PaymentStatus ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination">
        @{
            var routeValues = new Dictionary<string, string?>
            {
                ["fromDate"] = ViewData["FromDate"] as string,
                ["toDate"] = ViewData["ToDate"] as string,
                ["agentName"] = ViewData["AgentName"] as string,
                ["bookingStatus"] = ViewData["BookingStatus"] as string,
                ["paymentStatus"] = ViewData["PaymentStatus"] as string
            };
        }
        @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"] > 1)
        {
            var prevValues = new Dictionary<string, string?>(routeValues) { ["page"] = ((int)ViewData["CurrentPage"] - 1).ToString() };
            <a href="@Url.Action("Index", prevValues)">Previous</a>
        }

        @for (int i = 1; i <= (int)ViewData["TotalPages"]; i++)
        {
            var pageValues = new Dictionary<string, string?>(routeValues) { ["page"] = i.ToString() };
            <a href="@Url.Action("Index", pageValues)" class="@(i == (int)ViewData["CurrentPage"] ? "active" : "")">@i</a>
        }

        @if (ViewData["CurrentPage"] != null && (int)ViewData["CurrentPage"] < (int)ViewData["TotalPages"])
        {
            var nextValues = new Dictionary<string, string?>(routeValues) { ["page"] = ((int)ViewData["CurrentPage"] + 1).ToString() };
            <a href="@Url.Action("Index", nextValues)">Next</a>
        }
    </div>
</div>
