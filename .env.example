# Production Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────

# SQL Server SA password (strong password required by SQL Server)
DB_SA_PASSWORD=YourStr0ng$qlP@ss!123

# JWT signing
JWT_ISSUER=AshtavinayakApp
JWT_AUDIENCE=AshtavinayakApp-Users
JWT_SECRET=REPLACE_WITH_A_RANDOM_STRING_AT_LEAST_32_CHARS_LONG!

# Razorpay (use rzp_live_ keys for production)
RAZORPAY_KEY=rzp_live_REPLACE_ME
RAZORPAY_SECRET=REPLACE_ME

# BulkSMSPune gateway
SMS_USER=iTasT
SMS_PASSWORD=REPLACE_WITH_REAL_PASSWORD

# Admin panel login
ADMIN_USERNAME=admin
# Generate a new BCrypt hash: https://bcrypt-generator.com/ (cost factor 11)
ADMIN_PASSWORD_HASH=$2a$11$REPLACE_WITH_BCRYPT_HASH_OF_YOUR_ADMIN_PASSWORD
