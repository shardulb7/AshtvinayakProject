        {
          "name": "Get My Transactions (paginated)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/Transaction?page=1&pageSize=20",
              "host": ["{{base_url}}"],
              "path": ["api", "Transaction"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            },
            "description": "Get paginated transaction list.\n\n**Requires:** Any valid JWT.\n\n**Scoping:** Regular users only see their own transactions. Admins see all.\n\n**Success (200):**\n```json\n{\n  \"message\": \"Transactions fetched successfully.\",\n  \"totalCount\": 42,\n  \"totalPages\": 3,\n  \"currentPage\": 1,\n  \"pageSize\": 20,\n  \"data\": [\n    {\n      \"transactionId\": 1,\n      \"bookingCode\": \"BK-20260901-001\",\n      \"userName\": \"Test User\",\n      \"amount\": 1000,\n      \"transactionDate\": \"2026-09-01T10:00:00Z\",\n      \"paymentStatus\": \"Paid\",\n      \"paymentMethod\": \"Razorpay\"\n    }\n  ]\n}\n```\n\n`pageSize` max is 100."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has pagination fields', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('totalCount');",
                  "  pm.expect(json).to.have.property('data');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Transaction by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/Transaction/{{transaction_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "Transaction", "{{transaction_id}}"]
            },
            "description": "Get a single transaction by ID.\n\n**Requires:** Any valid JWT.\n\n**Scoping:** Users can only fetch their own transactions. Returns 404 if the ID belongs to another user (not a 403 — intentional, to avoid revealing that the ID exists)."
          },
          "response": []
        }
